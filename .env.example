# Copy to .env (never commit .env). Used by docker compose and the services.

# Shared secret between browsers and Nude services (also set it in the browser: Settings → Nude services)
NUDE_SERVICE_TOKEN=
# Admin token for crawl / threat-feed admin endpoints
NUDE_ADMIN_TOKEN=

# --- Nebula gateway: pick one provider (see docs/NEBULA_SETUP.md) ---
NUDE_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# NUDE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # or http://host.docker.internal:11434/v1 for Ollama
# Thorough model (pages, images, files) and fast model (quick chat). Defaults: claude-sonnet-5-5 and claude-haiku-5-5.
# NUDE_AI_MODEL=claude-sonnet-5-5
# NUDE_AI_FAST_MODEL=claude-haiku-5-5

# --- Nude Search fallback (used only while Nude's own index is thin; results are labelled) ---
BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=https://searx.example.com
NUDE_RECRAWL_MINUTES=0
