<?xml version="1.0" encoding="utf-8"?>
<!-- Nude Accounts is reached over HTTPS. Plain HTTP is allowed only so a Nude Accounts server on your own network
     can be used for testing; the code only accepts http for private network addresses (NudeId.parseLink). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
