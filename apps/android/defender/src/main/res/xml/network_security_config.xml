<?xml version="1.0" encoding="utf-8"?>
<!--
  The link to Nude on your PC is plain HTTP on your own Wi-Fi (private addresses only, checked in code), because a PC
  has no certificate for its local address. Every reply is encrypted and every request signed with the key from the
  QR code, so nothing readable crosses the network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
