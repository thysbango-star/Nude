{
  "name": "@nude/search",
  "version": "0.1.0",
  "private": true,
  "description": "Nude Search: crawler, indexer, ranking engine, search API and results UI",
  "scripts": {
    "start": "tsx src/server.ts",
    "crawl": "tsx src/cli.ts",
    "build": "esbuild src/server.ts src/cli.ts --bundle --platform=node --format=cjs --outdir=dist --packages=external",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "devDependencies": { "tsx": "^4.23.12", "esbuild": "^0.28.2" },
  "engines": { "node": ">=22.13" }
}
